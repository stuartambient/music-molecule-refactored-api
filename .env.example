# Optional development-only settings. Defaults work without a .env file.
# Copy to .env only if you do not already have one. Preserve existing overrides.
# Relative paths resolve from the directory containing package.json.
# On Windows use forward slashes; quote values containing spaces.
# Keep dev paths separate from the installed production app's data directory.
MAIN_VITE_DB_PATH_DEV=src/db/music.db

# The app appends /backups to this base directory.
MAIN_VITE_DB_BACKUP_DEV=src/db

# Packaged catalogs do not use MAIN_VITE_DB_PATH_PROD.
# MPV_EXECUTABLE is a process environment variable: set it in the launching shell,
# not here. See README.md for platform paths and mpv setup.
